(include "./hypringo.yuck")

;; Calendar Widget
(defpoll date :interval "1m" `env LANG=en.US date '+{"year":"%Y","week":"%a","day":"%d","month":"%b","hour":"%H","min":"%M"}'`)

(defwidget cal []
    (box :class "calendar-box"
         :orientation "h"
        (box :class "calendar-inner-box"
            (calendar :class "calendar"
                :day "${date.day}"
                :month "${date.month}"
                :year "${date.year}"
            )
        )
    )
)

;; Widgets on Center
(defvar mc-show "false")
(defwidget mcardalbum []
    (box :vexpand "false"
        :hexpand "false"
        :style "background-image:linear-gradient(to right, rgba(36, 40, 59, 0), rgba(36, 40, 59, 1) 46%), url('${music-cover}'); 
        background-repeat: no-repeat;
        background-size: 100% 150%, contain; 
        background-position: 33.33% 0, 0 0;
        border-radius: 15px; border: 2px solid rgba(26, 27, 38, 1)"
        (box :space-evenly "false"
            :orientation "v"
            :halign "end"
            :valign "center"
            :style "font-family: SF Pro Display; margin-right: 30px"
            (label
                :xalign "1"
                :wrap "true"
                :limit-width 15
                :style "font-weight: bold; font-size: 1.4em"
                :text "${hypringo.media.title}")
            (label
                :xalign "1"
                :wrap "true"
                :limit-width 15
                :style 'font-size: 1em'
                :text "${hypringo.media.artist}")
            (box :space-evenly "false"
                :orientation "h"
                :style "margin-top: 8px"
                :style "font-size: 3.5em"
                (button :style "margin: 10px"
                    :onclick "hypringo dispatch media previous"
                    "󰒮")
                (button :style "margin: 10px"
                    :onclick "hypringo dispatch media play-pause"
                    "${hypringo.media.status == "paused" ? "󰐊" : "󰏤"}")
                (button :style "margin: 10px"
                    :onclick "hypringo dispatch media next"
                    "󰒭")
            )
        )
    )
)

(deflisten music-cover `hypringo-cover-listen`)
(defwidget music []
    (eventbox
        :visible {hypringo.media.available && hypringo.media.title != ""}
        :onclick "${mc-show ? "${EWW_CMD} update mc-show=false && ${EWW_CMD} close mcard":"${EWW_CMD} update mc-show=true && ${EWW_CMD} open mcard"}"
        (box :space-evenly "false"
            :vexpand "false"
            :hexpand "false"
            (box :vexpand "false"
                :hexpand "false"
                :valign "center"
                :class "music-cover"
                :style "background-image:url('${music-cover}');"
            )
            (label
                :class "music-title"
                :wrap "false"
                :limit-width 15
                :text "${hypringo.media.title}")
        )
    )
)

(defwidget weather []
    (eventbox
        (box :orientation "h"
            :space-evenly "true"
            :valign "center"
            :class "weather"
            :tooltip "Location: ${hypringo.weather.location}
Temperature (Feels Like): ${hypringo.weather.feels_like}
Wind: ${hypringo.weather.wind}
Pressure: ${hypringo.weather.pressure}
Precipitation: ${hypringo.weather.precipitation}
Status: ${hypringo.weather.stale ? "stale" : (hypringo.weather.available ? "ready" : "unavailable")}"
            "${hypringo.weather.condition}${hypringo.weather.temperature}"
        )
    )
)

;; Center Widgets
(defwidget center []
   (box :orientation "h"
        :space-evenly "false"
        :halign "center"
        :hexpand "false"
        :vexpand "false"
        :class "center"
        (weather :vexpand "false")
        (music :vexpand "false")
    )
)

;; Widgets on Right

(defvar gh-show "false")
(defwidget gh-notifications [len]
    (box :orientation "h"
        :space-evenly "false"
        (button :onclick "${gh-show ? "${EWW_CMD} update gh-show=false && ${EWW_CMD} close ghn":"${EWW_CMD} update gh-show=true && ${EWW_CMD} open ghn"}"
         (label :class "gh-notifications"
            :text "${len > 0 ? "􀝗" : "􀋚"}")
         )
    )
)
(defwidget gh-list []
    (box :class "gh-list"
        :orientation "v"
        :space-evenly "false"
        (for notification in {hypringo.github.notifications}
            (gh-item :type "${notification.subject.type}"
                    :title "${notification.subject.title}"
                    :url "${notification.subject.url}")
        )
     )
)
(defwidget gh-item [type title url]
    (box :halign "start"
        :space-evenly "false"
        :class "gh-item ${type == "Issue" ? "gh-issue" :
            (type == "Discussion") ? "gh-discuss":
            (type == "PullRequest") ? "gh-pr":
            (type == "Commit") ? "gh-commit" : ""}"
            (box :class "gh-icon ${type == "Issue" ? "gh-icon-issue" :
                (type == "Discussion") ? "gh-icon-discuss":
                (type == "PullRequest") ? "gh-icon-pr":
                (type == "Commit") ? "gh-icon-commit" : ""}"
                "${type == "Issue" ? "􀍷" :
                (type == "Discussion") ? "􀒤":
                (type == "PullRequest") ? "":
                (type == "Commit") ? "􀡚" :
                (type == "Release") ? "" : "􀂓"}")
            (button :onclick "gh api ${url} | jq .html_url | xargs xdg-open &"
                (label
                    :limit-width 30
                    :text title)
            )
    )
)

(defwidget cpu-graph [avg]
    (box :class "cpu-graph"
        :orientation "v"
        :space-evenly "true"
        :tooltip "${round(avg, 2)}%"
        (graph :class "cpu-graph-inner"
                :height 5
                :width 45
                :value avg
                :max 20
                :min 0
                :dynamic "true"
                :thickness "2"
                :line-style "miter"
                :time-range "10s"
        )
    )
)

(defvar volum "false")
(defwidget volum []
    (eventbox :onhover "${EWW_CMD} update volum=true"
              :onhoverlost "${EWW_CMD} update volum=false"
            (box :orientation "h"
                 :space-evenly "false"
                 :spacing "2"
                 (revealer :transition "slideright"
                           :reveal volum
                           :duration "550ms"
                            (scale :class "volbar"
                                :value "${hypringo.audio.volume}.0"
                                :tooltip "Volume: ${hypringo.audio.volume} %"
                                :onchange "hypringo dispatch audio set-volume {}"
                                :orientation "h"
                                :max 100
                                :min 0
                            )
                )
                (button
                    :onclick "hypringo dispatch audio toggle-mute"
                    (label :class "volume-icon" :text "${hypringo.audio.muted ? "󰝟" : "󰕾"}"))
            )
    )
)

(defvar bright "false")
(defwidget bright []
    (eventbox
        :visible {hypringo.system.brightness.available}
        :onhover "${EWW_CMD} update bright=true"
        :onhoverlost "${EWW_CMD} update bright=false"
        (box :space-evenly "false"
             :orientation "h"
             :hexpand "false"
             :spacing 2
            (revealer :transition "slideright"
                      :reveal {bright && hypringo.system.brightness.capabilities.set}
                      :duration "550ms"
                        (scale :class "brightbar"
                             :value {hypringo.system.brightness.percent}
                             :tooltip "Brightness: ${hypringo.system.brightness.percent}%"
                             :onchange "hypringo dispatch brightness set {}"
                             :orientation "h"
                             :max 100
                             :min 0
                        )
            )
            (label :class "brightness-icon" :text "󰃠")
        )
    )
)

(defwidget battery []
    (box :orientation "h"
         :visible {hypringo.system.battery.available}
         :space-evenly "false"
        (label :class "battery"
               :valign "end"
               :text "${hypringo.system.battery.status == "Charging" ? "􀢋" :
                    hypringo.system.battery.capacity == 100 ? "􀛨" :
                    (hypringo.system.battery.capacity > 75 ? "􀺸" :
                    (hypringo.system.battery.capacity > 50 ? "􀺶" :
                    (hypringo.system.battery.capacity > 25 ? "􀛩" :
                    (hypringo.system.battery.capacity > 0 ? "􀛪" : "􀛪"))))}"
               :tooltip "Battery: ${hypringo.system.battery.capacity}% (${hypringo.system.battery.status})")))

(defwidget tray []
    (systray :class "tray"
             :pack-direction "ttb"
             :spacing 4
             :space-evenly false
             :icon-size 20
             :prepend-new true))

(defwidget control []
    (box :orientation "h"
         :space-evenly "false"
         :class "control"
         (tray)
         (volum)
         (bright)
         (gh-notifications :len {arraylength(hypringo.github.notifications)})
         (battery)
         (cpu-graph :avg {EWW_CPU['avg']})
))

(defvar calendar "false")
(defwidget time []
    (box :orientation "h"
         :class "time"
         :halign "end"
        (button :onclick "${calendar ?
                "${EWW_CMD} update calendar=false && ${EWW_CMD} close calendar" :
                "${EWW_CMD} update calendar=true && ${EWW_CMD} open calendar"}"
                "${date.week} ${date.day}. ${date.month} ${date.hour}:${date.min}")))

(defwidget power []
    (eventbox :onhover "${EWW_CMD} update power=true"
              :onhoverlost "${EWW_CMD} update power=false"
            (box :orientation "h"
                :space-evenly "false"
                :hexpand "false"
                :class "powermenu"
                (revealer :transition "slideright"
                          :reveal power
                          :duration "550ms"
                    (box :orientation "h"
                         :space-evenly "false"
                        (button :class "button-lock"
                                :tooltip "Lock"
                                :onclick "${lock}"
                                "")
                        (button :class "button-reboot"
                                :tooltip "Reboot"
                                :onclick "reboot" "")
                    )
                )
                (button :class "button-off"
                    :tooltip "Shutdown"
                    :onclick "shutdown now" "⏻")
            )
    )
)

(defvar power false)
(defvar lock "~/.config/hypr/scripts/lock-screen.sh")

(defwidget stats []
    (box :orientation "h"
         :space-evenly "false"
         (time)
         (power)
    )
)

;; Right Widgets
(defwidget right []
    (box :orientation "h"
         :space-evenly "false"
         :halign "end"
         :spacing 5
         (control)
         (stats))
)

;; Widgets on Left
(defwidget workspaces [monitor-id]
    (eventbox :onscroll "sh ~/.config/eww/scripts/change-active-workspace.sh {} ${hypringo.hyprland.active_workspace.id}"
        (box :class "workspaces"
            :space-evenly true
            :orientation "h"
            :valign "center"
            :halign "start"
            (for workspace in {hypringo.hyprland.workspaces}
                (button :onclick "hypringo dispatch workspace switch ${workspace.id}"
                    :visible "${(workspace.windows > 0 || workspace.id == hypringo.hyprland.active_workspace.id) && workspace.monitor == hypringo.hyprland.monitors[monitor-id].name}"
                    :class "${workspace.id == hypringo.hyprland.active_workspace.id ? "current" : ""} workspace-entry"
                    "${workspace.id}")
            )
        )
    )
)

(defwidget activewindow []
    (box :class "activewindow"
        :orientation "h"
        :space-evenly false
        :visible "${hypringo.hyprland.active_window.title != ""}"
        (box :class "activewindow-arrow" "")
        (label :text "${hypringo.hyprland.active_window.title}" :limit-width 15)
    )
)

(defwidget logo []
    (box :orientation "h"
         :class "logo"
         :space-evenly "false"
         :halign "start"
         ""))

;; Left Widgets
(defwidget left [monitor-id]
    (box :orientation "h"
         :space-evenly "false"
         :halign "start"
(logo)
(workspaces :monitor-id monitor-id)
(activewindow)))

;; Bar Widgets
(defwidget bar [monitor-id]
    (box :class "bar"
            :space-evenly "false"
            :orientation "h"
            :halign "center"
            :valign "center"
            :height 40
    (left :monitor-id monitor-id)
    (center)
    (right)))

;; Bar Windows
(defwindow bar
    :monitor 1
    :geometry (geometry :x "0"
                        :y "9"
                        :width "97.6%"
                        :height "40"
                        :anchor "top center")
    :stacking "fg"
    :wm-ignore false
    :hexpand "false"
    :vexpand "false"
(bar :monitor-id 1))

(defwindow builtin
    :monitor 0
    :geometry (geometry :x "0"
                        :y "9"
                        :width "97.6%"
                        :height "40"
                        :anchor "top center")
    :stacking "fg"
    :wm-ignore false
    :hexpand "false"
    :vexpand "false"
(bar :monitor-id 0))

;; Calendar Windows
(defwindow calendar
    :monitor 0
    :geometry (geometry :x "80%"
                        :y "70"
                        :width "60"
                        :height "270")
(cal))

;; Github Notifications Window
(defwindow ghn
    :monitor 0
    :geometry (geometry :x "72%"
                        :y "70"
                        :width "150")
    (gh-list)
)

;; Music Card
(defwindow mcard
    :monitor 0
    :geometry (geometry :x "40%"
                        :y "60"
                        :width "430"
                        :height "200")
    (mcardalbum)
)
