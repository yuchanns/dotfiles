(include "./hypringo.yuck")

;; Shared state
(defpoll date
    :interval "1m"
    :initial "{\"year\":\"\",\"week\":\"\",\"day\":\"\",\"month\":\"\",\"hour\":\"\",\"min\":\"\"}"
    `env LANG=en.US date '+{"year":"%Y","week":"%a","day":"%d","month":"%b","hour":"%H","min":"%M"}'`)
(defvar active-popup "")
(defvar volume-expanded false)
(defvar brightness-expanded false)
(defvar power-expanded false)
(defvar power-confirm "none")

(defwidget cal []
    (box :class "calendar-box"
         :orientation "h"
        (box :class "calendar-inner-box"
            (calendar :class "calendar"
                :day "${date.day}"
                :month "${date.month}"
                :year "${date.year}"
            )
        )
    )
)

(defwidget mcardalbum []
    (box :vexpand "false"
        :hexpand "false"
        :class "music-card"
        :style "background-image:linear-gradient(to right, rgba(36, 40, 59, 0), rgba(36, 40, 59, 1) 46%), url('${music-cover}'); 
                background-repeat:no-repeat;
                background-size:100% 150%, contain;
                background-position:33.33% 0, 0 0;"
        (box :space-evenly "false"
            :orientation "v"
            :halign "end"
            :valign "center"
            :class "music-card-content"
            (label
                :xalign "1"
                :wrap "true"
                :limit-width 15
                :class "music-card-title"
                :text "${hypringo.media.title}")
            (label
                :xalign "1"
                :wrap "true"
                :limit-width 15
                :class "music-card-artist"
                :text "${hypringo.media.artist}")
            (box :space-evenly "false"
                :orientation "h"
                :class "music-card-controls"
                (button
                    :class "music-card-button ${hypringo.media.capabilities.previous ? "" : "is-unavailable"}"
                    :onclick "${hypringo.media.capabilities.previous ? "hypringo dispatch media previous" : "true"}"
                    "󰒮")
                (button
                    :class "music-card-button ${hypringo.media.capabilities.play_pause ? "" : "is-unavailable"}"
                    :onclick "${hypringo.media.capabilities.play_pause ? "hypringo dispatch media play-pause" : "true"}"
                    "${hypringo.media.status == "paused" ? "󰐊" : "󰏤"}")
                (button
                    :class "music-card-button ${hypringo.media.capabilities.next ? "" : "is-unavailable"}"
                    :onclick "${hypringo.media.capabilities.next ? "hypringo dispatch media next" : "true"}"
                    "󰒭")
            )
        )
    )
)

(deflisten music-cover `hypringo-cover-listen`)
(defwidget music [monitor-name]
    (eventbox
        :visible {hypringo.media.available && hypringo.media.title != ""}
        :onclick "eww-desktop-action popup music ${monitor-name}"
        :tooltip "${hypringo.media.title}
${hypringo.media.artist}"
        (box :space-evenly "false"
            :vexpand "false"
            :hexpand "false"
            :class "${hypringo.media.connected ? "" : "is-unavailable"}"
            (box :vexpand "false"
                :hexpand "false"
                :valign "center"
                :class "music-cover"
                :style "background-image:url('${music-cover}');"
            )
            (label
                :class "music-title"
                :wrap "false"
                :limit-width 15
                :text "${hypringo.media.title}")
        )
    )
)

(defwidget weather-card []
    (box :orientation "v"
        :space-evenly "false"
        :class "weather-card ${hypringo.weather.available ? (hypringo.weather.stale ? "is-stale" : "") : "is-unavailable"}"
        (box :orientation "h"
            :space-evenly "false"
            :class "weather-card-hero"
            (label
                :class "weather-card-condition"
                :valign "center"
                :text "${hypringo.weather.available ? hypringo.weather.condition : "󰖐"}")
            (box :orientation "v"
                :space-evenly "false"
                :valign "center"
                :class "weather-card-summary"
                (label
                    :class "weather-card-location"
                    :xalign 0
                    :limit-width 26
                    :text "${hypringo.weather.location != "" ? hypringo.weather.location : "Weather unavailable"}")
                (label
                    :class "weather-card-temperature"
                    :xalign 0
                    :text "${hypringo.weather.temperature != "" ? hypringo.weather.temperature : "--"}")
                (label
                    :class "weather-card-feels-like"
                    :xalign 0
                    :text "Feels like ${hypringo.weather.feels_like != "" ? hypringo.weather.feels_like : "--"}")))
        (box :orientation "h"
            :space-evenly "true"
            :class "weather-card-metrics"
            (box :orientation "v"
                :class "weather-card-metric"
                (label :class "weather-card-metric-icon weather-card-wind" :text "󰖝")
                (label :class "weather-card-metric-value" :text "${hypringo.weather.wind != "" ? hypringo.weather.wind : "--"}")
                (label :class "weather-card-metric-label" :text "Wind"))
            (box :orientation "v"
                :class "weather-card-metric"
                (label :class "weather-card-metric-icon weather-card-pressure" :text "󰓅")
                (label :class "weather-card-metric-value" :text "${hypringo.weather.pressure != "" ? hypringo.weather.pressure : "--"}")
                (label :class "weather-card-metric-label" :text "Pressure"))
            (box :orientation "v"
                :class "weather-card-metric"
                (label :class "weather-card-metric-icon weather-card-rain" :text "󰖗")
                (label :class "weather-card-metric-value" :text "${hypringo.weather.precipitation != "" ? hypringo.weather.precipitation : "--"}")
                (label :class "weather-card-metric-label" :text "Precipitation")))
        (box :orientation "h"
            :space-evenly "false"
            :halign "end"
            :class "weather-card-status"
            (label
                :class "weather-card-status-dot"
                :text "●")
            (label
                :text "${hypringo.weather.stale ? "Last known conditions" : (hypringo.weather.available ? "Live conditions" : "Data unavailable")}")))
)

(defwidget weather [monitor-name]
    (eventbox
        :onclick "eww-desktop-action popup weather ${monitor-name}"
        (box :orientation "h"
            :space-evenly "true"
            :valign "center"
            :class "weather ${hypringo.weather.available ? (hypringo.weather.stale ? "is-stale" : "") : "is-unavailable"}"
            (label :text "${hypringo.weather.condition}${hypringo.weather.temperature}")
            (label :visible {hypringo.weather.stale || !hypringo.weather.available}
                :class "state-badge"
                :text "${hypringo.weather.stale ? "󰏤" : "󰅙"}")
        )
    )
)

(defwidget center [monitor-name]
   (box :orientation "h"
        :space-evenly "false"
        :halign "center"
        :hexpand "false"
        :vexpand "false"
        :class "center"
        (weather :monitor-name monitor-name :vexpand "false")
        (music :monitor-name monitor-name :vexpand "false")
    )
)

(defwidget gh-notifications [len monitor-name]
    (box :orientation "h"
        :space-evenly "false"
        (button
            :class "${hypringo.github.available ? (hypringo.github.stale ? "is-stale" : "") : "is-unavailable"}"
            :onclick "eww-desktop-action popup github ${monitor-name}"
            :tooltip "GitHub notifications: ${len}
Status: ${hypringo.github.stale ? "stale" : (hypringo.github.available ? "ready" : "unavailable")}"
            (box :orientation "h"
                :space-evenly "false"
                (label :class "gh-notifications"
                    :text "${len > 0 ? "􀝗" : "􀋚"}")
                (label :visible {len > 0}
                    :class "notification-badge"
                    :text "${len > 99 ? "99+" : len}")))
    )
)
(defwidget gh-list []
    (box :class "gh-list"
        :orientation "v"
        :space-evenly "false"
        (for notification in {hypringo.github.notifications}
            (gh-item :type "${notification.subject.type}"
                    :title "${notification.subject.title}"
                    :url "${notification.subject.url}")
        )
     )
)
(defwidget gh-item [type title url]
    (box :halign "start"
        :space-evenly "false"
        :class "gh-item ${type == "Issue" ? "gh-issue" :
            (type == "Discussion") ? "gh-discuss":
            (type == "PullRequest") ? "gh-pr":
            (type == "Commit") ? "gh-commit" : ""}"
            (box :class "gh-icon ${type == "Issue" ? "gh-icon-issue" :
                (type == "Discussion") ? "gh-icon-discuss":
                (type == "PullRequest") ? "gh-icon-pr":
                (type == "Commit") ? "gh-icon-commit" : ""}"
                "${type == "Issue" ? "􀍷" :
                (type == "Discussion") ? "􀒤":
                (type == "PullRequest") ? "":
                (type == "Commit") ? "􀡚" :
                (type == "Release") ? "" : "􀂓"}")
            (button
                :onclick "eww-desktop-action open-github ${url}"
                :tooltip title
                (label
                    :limit-width 30
                    :text title)
            )
    )
)

(defwidget cpu-graph [avg]
    (box :class "cpu-graph"
        :orientation "v"
        :space-evenly "true"
        :tooltip "${round(avg, 2)}%"
        (graph :class "cpu-graph-inner"
                :height 19
                :width 45
                :value avg
                :max 100
                :min 0
                :dynamic "true"
                :thickness "2"
                :line-style "miter"
                :time-range "10s"
        )
    )
)

(defwidget volum []
    (eventbox
        :onhover "${EWW_CMD} update volume-expanded=true"
        :onhoverlost "${EWW_CMD} update volume-expanded=false"
        (box :orientation "h"
            :space-evenly "false"
            :spacing 2
            :class "${hypringo.audio.available ? (hypringo.audio.muted ? "is-muted" : "") : "is-unavailable"}"
            (revealer :transition "slideright"
                :reveal {volume-expanded && hypringo.audio.capabilities.set_volume}
                :duration "550ms"
                (scale :class "volbar"
                    :value "${hypringo.audio.volume}.0"
                    :tooltip "Volume: ${hypringo.audio.volume}%"
                    :onchange "hypringo dispatch audio set-volume {}"
                    :orientation "h"
                    :max 100
                    :min 0))
            (button
                :onclick "${hypringo.audio.capabilities.toggle_mute ? "hypringo dispatch audio toggle-mute" : "true"}"
                :tooltip "${hypringo.audio.available ? "Toggle mute" : "Audio unavailable"}"
                (label :class "volume-icon"
                    :text "${hypringo.audio.muted ? "󰝟" : "󰕾"}")))
    )
)

(defwidget bright []
    (eventbox
        :visible {hypringo.system.brightness.available}
        :onhover "${EWW_CMD} update brightness-expanded=true"
        :onhoverlost "${EWW_CMD} update brightness-expanded=false"
        (box
            :space-evenly "false"
            :orientation "h"
            :hexpand "false"
            :spacing 2
            (revealer :transition "slideright"
                :reveal {brightness-expanded && hypringo.system.brightness.capabilities.set}
                :duration "550ms"
                        (scale :class "brightbar"
                             :value {hypringo.system.brightness.percent}
                             :tooltip "Brightness: ${hypringo.system.brightness.percent}%"
                             :onchange "hypringo dispatch brightness set {}"
                             :orientation "h"
                             :max 100
                             :min 0
                        ))
            (label :class "brightness-icon" :text "󰃠"))
    )
)

(defwidget battery []
    (box :orientation "h"
         :visible {hypringo.system.battery.available}
         :space-evenly "false"
        (label :class "battery"
               :valign "end"
               :text "${hypringo.system.battery.status == "Charging" ? "􀢋" :
                    hypringo.system.battery.capacity == 100 ? "􀛨" :
                    (hypringo.system.battery.capacity > 75 ? "􀺸" :
                    (hypringo.system.battery.capacity > 50 ? "􀺶" :
                    (hypringo.system.battery.capacity > 25 ? "􀛩" :
                    (hypringo.system.battery.capacity > 0 ? "􀛪" : "􀛪"))))}"
               :tooltip "Battery: ${hypringo.system.battery.capacity}% (${hypringo.system.battery.status})")))

(defwidget tray []
    (systray :class "tray"
             :spacing 4
             :space-evenly false
             :icon-size 20
             :prepend-new true))

(defwidget health-indicator []
    (label
        :visible {!hypringo.runtime.ready
            || hypringo.runtime.last_reload_error != ""
            || hypringo.hyprland.error != ""
            || hypringo.audio.error != ""
            || hypringo.system.error != ""
            || hypringo.weather.stale
            || hypringo.github.stale}
        :class "health-indicator ${(!hypringo.runtime.ready
            || hypringo.runtime.last_reload_error != ""
            || hypringo.hyprland.error != ""
            || hypringo.audio.error != ""
            || hypringo.system.error != "") ? "is-error" : "is-stale"}"
        :tooltip "Runtime: ${hypringo.runtime.ready ? "ready" : "not ready"}
Reload: ${hypringo.runtime.last_reload_error}
Hyprland: ${hypringo.hyprland.error}
Audio: ${hypringo.audio.error}
System: ${hypringo.system.error}
Weather: ${hypringo.weather.stale ? "stale" : "ready"}
GitHub: ${hypringo.github.stale ? "stale" : "ready"}"
        :text "${(!hypringo.runtime.ready
            || hypringo.runtime.last_reload_error != ""
            || hypringo.hyprland.error != ""
            || hypringo.audio.error != ""
            || hypringo.system.error != "") ? "󰅙" : "󰏤"}"))

(defwidget control [monitor-name]
    (box :orientation "h"
         :space-evenly "false"
         :class "control"
         (tray)
         (volum)
         (bright)
         (gh-notifications
            :len {arraylength(hypringo.github.notifications)}
            :monitor-name monitor-name)
         (battery)
         (cpu-graph :avg {EWW_CPU['avg']})
         (health-indicator)
))

(defwidget time [monitor-name]
    (box :orientation "h"
         :class "time"
         :halign "end"
        (button :onclick "eww-desktop-action popup calendar ${monitor-name}"
                "${date.week} ${date.day}. ${date.month} ${date.hour}:${date.min}")))

(defwidget power []
    (eventbox
        :onhover "${EWW_CMD} update power-expanded=true"
        :onhoverlost "${EWW_CMD} update power-expanded=false power-confirm=none"
        (box :orientation "h"
            :space-evenly "false"
            :hexpand "false"
            :class "powermenu"
            (revealer :transition "slideright"
                :reveal power-expanded
                :duration "550ms"
                (box :orientation "h"
                    :space-evenly "false"
                    (button
                        :visible {power-confirm == "none"}
                        :class "button-lock"
                        :tooltip "Lock"
                        :onclick "eww-desktop-action power lock"
                        "")
                    (button
                        :visible {power-confirm == "none"}
                        :class "button-reboot"
                        :tooltip "Reboot"
                        :onclick "${EWW_CMD} update power-confirm=reboot"
                        "")
                    (button
                        :visible {power-confirm != "none"}
                        :class "button-cancel"
                        :tooltip "Cancel"
                        :onclick "${EWW_CMD} update power-confirm=none"
                        "󰜺")
                    (button
                        :visible {power-confirm != "none"}
                        :class "${power-confirm == "reboot" ? "button-reboot" : "button-off"}"
                        :tooltip "${power-confirm == "reboot" ? "Confirm reboot" : "Confirm shutdown"}"
                        :onclick "${power-confirm == "reboot" ? "eww-desktop-action power reboot" : "eww-desktop-action power poweroff"}"
                        "${power-confirm == "reboot" ? "" : "⏻"}")))
            (button :class "button-off"
                :tooltip "Shutdown"
                :onclick "${EWW_CMD} update power-expanded=true power-confirm=poweroff"
                "⏻"))
    )
)

(defwidget stats [monitor-name]
    (box :orientation "h"
         :space-evenly "false"
         (time :monitor-name monitor-name)
         (power)
    )
)

(defwidget right [monitor-name]
    (box :orientation "h"
         :space-evenly "false"
         :halign "end"
         :spacing 5
         (control :monitor-name monitor-name)
         (stats :monitor-name monitor-name))
)

(defwidget workspaces [monitor-name]
    (eventbox :onscroll "eww-desktop-action workspace-scroll {} ${monitor-name}"
        (box :class "workspaces"
            :space-evenly true
            :orientation "h"
            :valign "center"
            :halign "start"
            (for workspace in {hypringo.hyprland.workspaces}
                (button :onclick "hypringo dispatch workspace switch ${workspace.id}"
                    :visible "${(workspace.windows > 0 || workspace.id == hypringo.hyprland.active_workspace.id) && workspace.monitor == monitor-name}"
                    :class "${workspace.id == hypringo.hyprland.active_workspace.id ? "current" : ""} workspace-entry"
                    :tooltip "${workspace.last_window_title}"
                    "${workspace.id}")
            )
        )
    )
)

(defwidget activewindow [monitor-name]
    (box :class "activewindow"
        :orientation "h"
        :space-evenly false
        :visible "${hypringo.hyprland.active_window.title != "" && hypringo.hyprland.active_workspace.monitor == monitor-name}"
        :tooltip "${hypringo.hyprland.active_window.title}"
        (box :class "activewindow-arrow" "")
        (label :text "${hypringo.hyprland.active_window.title}" :limit-width 15)
    )
)

(defwidget logo []
    (box :orientation "h"
         :class "logo"
         :space-evenly "false"
         :halign "start"
         ""))

(defwidget left [monitor-name]
    (box :orientation "h"
         :space-evenly "false"
         :halign "start"
        (logo)
        (workspaces :monitor-name monitor-name)
        (activewindow :monitor-name monitor-name)))

(defwidget bar-content [monitor-name]
    (box :class "bar-stage"
        :hexpand true
        :vexpand false
        :valign "center"
        (centerbox :class "bar-surface"
            :halign "center"
            :hexpand false
            (box :class "bar-left"
                :halign "start"
                (left :monitor-name monitor-name))
            (box :class "bar-center"
                :halign "center"
                (center :monitor-name monitor-name))
            (box :class "bar-right"
                :halign "end"
                (right :monitor-name monitor-name)))))

(defwindow bar [monitor-name]
    :geometry (geometry :x "0"
                        :y "9"
                        :width "97.6%"
                        :height "40"
                        :anchor "top center")
    :stacking "fg"
    :wm-ignore false
    :hexpand "false"
    :vexpand "false"
(bar-content :monitor-name monitor-name))

(defwindow calendar
    :geometry (geometry :x "80%"
                        :y "70"
                        :width "60"
                        :height "270")
(cal))

(defwindow ghn
    :geometry (geometry :x "72%"
                        :y "70"
                        :width "150")
    (gh-list)
)

(defwindow mcard
    :geometry (geometry :x "40%"
                        :y "60"
                        :width "430"
                        :height "200")
    (mcardalbum)
)

(defwindow wcard
    :geometry (geometry :x "38%"
                        :y "60"
                        :width "460"
                        :height "250")
    (weather-card)
)
